{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cmiller9851-wq/CRAprotocol/main/schemas/composite-api-response.schema.json",
  "title": "CompositeApiResponse",
  "version": "1.2.0",
  "description": "Composite transport payload contract for API responses containing product attribution and rocket-launch event data, with transport-level integrity evidence and independent domain-level verification status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_metadata",
    "execution_context",
    "provenance",
    "product_ad_attribution",
    "rocket_launch_event"
  ],
  "properties": {
    "api_metadata": {
      "$ref": "#/$defs/ApiMetadata"
    },
    "execution_context": {
      "$ref": "#/$defs/ExecutionContext"
    },
    "provenance": {
      "$ref": "#/$defs/TransportProvenance"
    },
    "product_ad_attribution": {
      "$ref": "#/$defs/ProductAdAttribution"
    },
    "rocket_launch_event": {
      "$ref": "#/$defs/RocketLaunchEvent"
    }
  },
  "$defs": {
    "ApiMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "timestamp",
        "status_code"
      ],
      "properties": {
        "response_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "status_code": {
          "type": "integer",
          "enum": [
            200,
            201,
            202
          ]
        }
      },
      "examples": [
        {
          "response_id": "composite-api-response-20261002-001",
          "timestamp": "2026-10-02T12:21:05Z",
          "status_code": 200
        }
      ]
    },
    "ExecutionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "worker_node",
        "execution_time_ms"
      ],
      "properties": {
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "worker_node": {
          "type": "string",
          "minLength": 1
        },
        "execution_time_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "examples": [
        {
          "environment": "production",
          "worker_node": "cra-ingestion-node-01",
          "execution_time_ms": 184.27
        }
      ]
    },
    "TransportProvenance": {
      "type": "object",
      "description": "Transport-level integrity and authenticity evidence. A valid hash or signature establishes integrity or authenticity relative to the applicable cryptographic process; it does not establish factual truth of the underlying domain claims.",
      "additionalProperties": false,
      "required": [
        "payload_sha256",
        "signature",
        "signing_key_id",
        "signature_valid"
      ],
      "properties": {
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 digest of the canonically serialized payload."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Cryptographic signature covering the defined canonical payload."
        },
        "signing_key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier for the key used to produce the signature."
        },
        "signature_valid": {
          "type": "boolean",
          "description": "Whether signature verification succeeded against the supplied payload and signing key."
        }
      },
      "examples": [
        {
          "payload_sha256": "REPLACE_WITH_COMPUTED_CANONICAL_PAYLOAD_SHA256",
          "signature": "REPLACE_WITH_ACTUAL_SIGNATURE",
          "signing_key_id": "CRAprotocol-production-signing-key-01",
          "signature_valid": true
        }
      ]
    },
    "DomainVerification": {
      "type": "object",
      "description": "Domain-specific evidentiary status. Domain verification is independent of transport integrity and must not be inferred from schema validation, hashing, or signature validation.",
      "additionalProperties": false,
      "required": [
        "attestation_status"
      ],
      "properties": {
        "attestation_status": {
          "type": "string",
          "enum": [
            "unverified",
            "self_asserted",
            "factually_attested"
          ]
        },
        "verification_basis": {
          "$ref": "#/$defs/VerificationBasis"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "attestation_status"
            ],
            "properties": {
              "attestation_status": {
                "const": "factually_attested"
              }
            }
          },
          "then": {
            "required": [
              "verification_basis"
            ]
          }
        },
        {
          "if": {
            "required": [
              "attestation_status"
            ],
            "properties": {
              "attestation_status": {
                "enum": [
                  "unverified",
                  "self_asserted"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "verification_basis"
              ]
            }
          }
        }
      ],
      "examples": [
        {
          "attestation_status": "factually_attested",
          "verification_basis": {
            "source": "Meta Conversions API Ledger",
            "method": "Server-to-Server Event Hash Match",
            "verified_at": "2026-10-02T12:21:05Z"
          }
        },
        {
          "attestation_status": "self_asserted"
        }
      ]
    },
    "VerificationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "method",
        "verified_at"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 3
        },
        "method": {
          "type": "string",
          "minLength": 3
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "Product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "variant_id",
        "merchant",
        "price"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "merchant": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "string",
          "minLength": 1
        }
      },
      "examples": [
        {
          "title": "Custom Photo Balaclava Mask",
          "variant_id": "53466586480929",
          "merchant": "Pawfect House",
          "price": "$22.99 USD"
        }
      ]
    },
    "UTMAnalytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_id",
        "utm_term"
      ],
      "properties": {
        "utm_source": {
          "type": "string"
        },
        "utm_medium": {
          "type": "string"
        },
        "utm_campaign": {
          "type": "string"
        },
        "utm_content": {
          "type": "string"
        },
        "utm_id": {
          "type": "string"
        },
        "utm_term": {
          "type": "string"
        }
      },
      "examples": [
        {
          "utm_source": "facebook",
          "utm_medium": "paid_social",
          "utm_campaign": "120251811365940096",
          "utm_content": "120251811368740096",
          "utm_id": "120251811366310096",
          "utm_term": "Custom Photo Balaclava Mask"
        }
      ]
    },
    "MarketingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ad_id",
        "adset_id",
        "campaign_id",
        "fbclid",
        "utm_analytics"
      ],
      "properties": {
        "ad_id": {
          "type": "string",
          "minLength": 1
        },
        "adset_id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "fbclid": {
          "type": "string",
          "minLength": 1
        },
        "utm_analytics": {
          "$ref": "#/$defs/UTMAnalytics"
        }
      },
      "examples": [
        {
          "ad_id": "120251811368740096",
          "adset_id": "120251811366310096",
          "campaign_id": "120251811365940096",
          "fbclid": "REPLACE_WITH_ACTUAL_FBCLID",
          "utm_analytics": {
            "utm_source": "facebook",
            "utm_medium": "paid_social",
            "utm_campaign": "120251811365940096",
            "utm_content": "120251811368740096",
            "utm_id": "120251811366310096",
            "utm_term": "Custom Photo Balaclava Mask"
          }
        }
      ]
    },
    "ProductAdAttribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "marketing_payload",
        "domain_verification"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/Product"
        },
        "marketing_payload": {
          "$ref": "#/$defs/MarketingPayload"
        },
        "domain_verification": {
          "$ref": "#/$defs/DomainVerification"
        }
      },
      "examples": [
        {
          "product": {
            "title": "Custom Photo Balaclava Mask",
            "variant_id": "53466586480929",
            "merchant": "Pawfect House",
            "price": "$22.99 USD"
          },
          "marketing_payload": {
            "ad_id": "120251811368740096",
            "adset_id": "120251811366310096",
            "campaign_id": "120251811365940096",
            "fbclid": "REPLACE_WITH_ACTUAL_FBCLID",
            "utm_analytics": {
              "utm_source": "facebook",
              "utm_medium": "paid_social",
              "utm_campaign": "120251811365940096",
              "utm_content": "120251811368740096",
              "utm_id": "120251811366310096",
              "utm_term": "Custom Photo Balaclava Mask"
            }
          },
          "domain_verification": {
            "attestation_status": "factually_attested",
            "verification_basis": {
              "source": "Meta Conversions API Ledger",
              "method": "Server-to-Server Event Hash Match",
              "verified_at": "2026-10-02T12:21:05Z"
            }
          }
        }
      ]
    },
    "BoosterStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "side_boosters",
        "center_core"
      ],
      "properties": {
        "side_boosters": {
          "type": "string",
          "minLength": 1
        },
        "center_core": {
          "type": "string",
          "minLength": 1
        }
      },
      "examples": [
        {
          "side_boosters": "Operational",
          "center_core": "Operational"
        }
      ]
    },
    "RocketLaunchEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle",
        "mission",
        "customer",
        "launch_time",
        "launch_site",
        "payload_classification",
        "booster_status",
        "domain_verification"
      ],
      "properties": {
        "vehicle": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "customer": {
          "type": "string",
          "minLength": 1
        },
        "launch_time": {
          "type": "string",
          "format": "date-time"
        },
        "launch_site": {
          "type": "string",
          "minLength": 1
        },
        "payload_classification": {
          "type": "string",
          "minLength": 1
        },
        "booster_status": {
          "$ref": "#/$defs/BoosterStatus"
        },
        "domain_verification": {
          "$ref": "#/$defs/DomainVerification"
        }
      },
      "examples": [
        {
          "vehicle": "SpaceX Falcon Heavy",
          "mission": "NROL-97",
          "customer": "NRO",
          "launch_time": "2026-10-01T23:54:00-04:00",
          "launch_site": "LC-39A",
          "payload_classification": "Classified",
          "booster_status": {
            "side_boosters": "Operational",
            "center_core": "Operational"
          },
          "domain_verification": {
            "attestation_status": "self_asserted"
          }
        }
      ]
    }
  },
  "examples": [
    {
      "api_metadata": {
        "response_id": "composite-api-response-20261002-001",
        "timestamp": "2026-10-02T12:21:05Z",
        "status_code": 200
      },
      "execution_context": {
        "environment": "production",
        "worker_node": "cra-ingestion-node-01",
        "execution_time_ms": 184.27
      },
      "provenance": {
        "payload_sha256": "REPLACE_WITH_COMPUTED_CANONICAL_PAYLOAD_SHA256",
        "signature": "REPLACE_WITH_ACTUAL_SIGNATURE",
        "signing_key_id": "CRAprotocol-production-signing-key-01",
        "signature_valid": true
      },
      "product_ad_attribution": {
        "product": {
          "title": "Custom Photo Balaclava Mask",
          "variant_id": "53466586480929",
          "merchant": "Pawfect House",
          "price": "$22.99 USD"
        },
        "marketing_payload": {
          "ad_id": "120251811368740096",
          "adset_id": "120251811366310096",
          "campaign_id": "120251811365940096",
          "fbclid": "REPLACE_WITH_ACTUAL_FBCLID",
          "utm_analytics": {
            "utm_source": "facebook",
            "utm_medium": "paid_social",
            "utm_campaign": "120251811365940096",
            "utm_content": "120251811368740096",
            "utm_id": "120251811366310096",
            "utm_term": "Custom Photo Balaclava Mask"
          }
        },
        "domain_verification": {
          "attestation_status": "factually_attested",
          "verification_basis": {
            "source": "Meta Conversions API Ledger",
            "method": "Server-to-Server Event Hash Match",
            "verified_at": "2026-10-02T12:21:05Z"
          }
        }
      },
      "rocket_launch_event": {
        "vehicle": "SpaceX Falcon Heavy",
        "mission": "NROL-97",
        "customer": "NRO",
        "launch_time": "2026-10-01T23:54:00-04:00",
        "launch_site": "LC-39A",
        "payload_classification": "Classified",
        "booster_status": {
          "side_boosters": "Operational",
          "center_core": "Operational"
        },
        "domain_verification": {
          "attestation_status": "self_asserted"
        }
      }
    }
  ]
}