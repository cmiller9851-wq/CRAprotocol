{
  "$schema": "https://json-schema.org",
  "title": "CRA_Verifier_Audit_Response",
  "type": "object",
  "required": [
    "audit_id",
    "target_root",
    "verification_status",
    "attestation_signature"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "target_root": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "verification_status": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED_REVOKED_FIRMWARE", "REJECTED_TOPOLOGY_MISMATCH"],
      "description": "The definitive deterministic verification outcome."
    },
    "attestation_signature": {
      "type": "string",
      "description": "Cryptographic ECDSA/Ed25519 signature confirming the verifier's state validation."
    }
  }
}