# === 1. CORE RUNTIME =======================================================
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=0.5
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_BACKOFF=0.25

# === 2. SETTLEMENT ROUTING (verified on-chain 2026-11-09) ==================
# Primary collection wallet (Coinbase Smart Wallet created 2026-01-10;
# both cmillerr.cb.id and swervincurvin.base.eth resolve to it)
X402_RECIPIENT=0x421949B526e7e215a64E88E6F4cEE6ABd10a2500

# Base micro-payment price per paywalled request (USDC)
X402_PRICE_USDC=0.01

# Enable/disable paywall enforcement (1 = enforced, 0 = open for staging)
X402_PAYWALL_ENABLED=1

# Shared HMAC secret for client-server x402 signatures (base64)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
X402_HMAC_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE

# === 3. COINBASE CDP AUTO-SWEEP ENGINE =====================================
# Auto-sweep runs as a supervisor agent loop every 60s
# Destination: 'cmillerr.cb.id' keeps funds in the smart wallet (safe default);
# set 'cmiller.cb.id' to route to the 2023 cold wallet (0xeEBdcafB...)
SWEEP_DESTINATION=cmillerr.cb.id
SWEEP_THRESHOLD_USDC=5.0
SWEEP_RESERVE_USDC=0.5
SWEEP_COOLDOWN_SECONDS=1800

# SAFETY: 0 = dry-run (simulated, no real funds moved); 1 = live sweeps
SWEEP_LIVE=0

# --- Live mode credentials (provide ONE of the two paths below) -----------
# Path A: Coinbase CDP credentials (create at portal.cdp.coinbase.com)
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# Path B: raw wallet private key for ERC-20 transfer fallback
SWEEP_WALLET_PRIVATE_KEY=

# === 4. RPC ENDPOINTS ======================================================
BASE_RPC=https://mainnet.base.org
ETH_RPC=https://ethereum-rpc.publicnode.com

# === 5. STRIPE SETTLEMENT RAIL (optional) =================================
# Required only if you process card/ACH settlements through Stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=

# === 6. MAPBOX TELEMETRY (optional) =======================================
MAPBOX_ACCESS_TOKEN=

# === 7. KUBERNETES / NETWORKING ============================================
PORT=8000
HOST=0.0.0.0
